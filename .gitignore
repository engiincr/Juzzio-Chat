# =============================================================================
# JUZZIO .gitignore (v0.9.7 — sıkılaştırılmış)
# Kural: gizli anahtar, imza dosyası, yerel veritabanı/önbellek ve derleme çıktısı
# ASLA depoya girmez. Gerçek anahtarlar yalnız GitHub Secrets / Supabase Secrets'ta durur.
# `scripts/check_secrets.py` bu kuralları CI'da ayrıca doğrular (izlenen yasak dosya = hata).
# =============================================================================

# ---- Ortam değişkenleri ve gizli anahtar kasası ------------------------------
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
.envrc
.secrets
secrets.json
secrets.yaml
secrets.yml
*.secret
*.secrets
credentials.json
client_secret*.json
*service-account*.json
*firebase-adminsdk*.json
.netrc
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*
supabase/functions/**/.env

# ---- Firebase / Google yapılandırmaları --------------------------------------
android/app/google-services.json
!android/app/google-services.json.example
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
.firebase/
firebase-debug.log
firebase-debug.*.log

# ---- İmza anahtarları, sertifikalar ve türevleri -----------------------------
*.jks
*.jks.*
*.keystore
*.pem
*.p8
*.p12
*.pfx
*.key
*.cer
*.crt
*.mobileprovision
key.properties
android/key.properties
keystore_base64.txt
*_base64.txt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# ---- Yerel veritabanı ve önbellekler (Drift / SQLite) ------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
juzzio_cache/

# ---- Flutter / Dart -----------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
*.iml
.metadata.bak
lib/generated_plugin_registrant.dart

# ---- Android -------------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/app/build/
android/app/.cxx/
android/.externalNativeBuild/
android/captures/
android/local.properties
android/gradle-wrapper.jar.bak
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# ---- iOS / macOS -----------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
ios/Runner.xcworkspace/xcuserdata/
**/xcuserdata/
*.xcuserstate
DerivedData/

# ---- Web / Node araçları ----------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/

# ---- Supabase CLI yerel durumu ve CI çıktıları -----------------------------------
supabase/.temp/
supabase/.branches/
supabase/.vscode/
release-output/
predeploy/

# ---- IDE ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Tanı ve geçici dosyalar ------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
/push.txt
/log.txt
/build_error.log
