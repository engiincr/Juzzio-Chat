<?xml version="1.0" encoding="utf-8"?>
<!-- v2.1 (Faz 17.2): Google Play paketi (JUZZIO_PLAY=1 ile derlenen release) için ek manifest.
     Play'den dağıtılan uygulama kendini Play dışından güncelleyemez; bu yüzden APK kurma izni kaldırılır.
     GitHub/OTA ile dağıtılan normal APK bu dosyadan etkilenmez. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
</manifest>
