<?xml version="1.0" encoding="utf-8"?>
<!-- 2) Hızlı eylemler 4x1: sohbetler, yeni mesaj, kamera, aramalar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/juzzio_wbg_dark" android:orientation="horizontal" android:padding="6dp">
    <LinearLayout android:id="@+id/w_a1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/w_a1_icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:background="@drawable/juzzio_wbtn_dark" android:contentDescription="@null" android:src="@drawable/ic_juzzio_widget_chat" />
        <TextView android:id="@+id/w_a1_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_a2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/w_a2_icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:background="@drawable/juzzio_wbtn_dark" android:contentDescription="@null" android:src="@drawable/ic_juzzio_widget_edit" />
        <TextView android:id="@+id/w_a2_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_a3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/w_a3_icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:background="@drawable/juzzio_wbtn_dark" android:contentDescription="@null" android:src="@drawable/ic_juzzio_widget_camera" />
        <TextView android:id="@+id/w_a3_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_a4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/w_a4_icon" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
            android:background="@drawable/juzzio_wbtn_dark" android:contentDescription="@null" android:src="@drawable/ic_juzzio_widget_call" />
        <TextView android:id="@+id/w_a4_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
