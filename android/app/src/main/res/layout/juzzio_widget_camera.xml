<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/juzzio_wbg_dark" android:gravity="center" android:orientation="vertical" android:padding="8dp">
    <ImageView android:id="@+id/w_icon" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
        android:background="@drawable/juzzio_wbtn_dark" android:contentDescription="@null" android:src="@drawable/ic_juzzio_widget_camera" />
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:maxLines="1" android:textColor="#D9FFFFFF" android:textSize="11sp" />
</LinearLayout>
