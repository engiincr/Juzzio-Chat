<?xml version="1.0" encoding="utf-8"?>
<!-- Juzzio v1.1.0 açılış: derin mor-lacivert zemin + ortada yeni logo (Flutter açılış ekranına kesintisiz geçer) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="140%p"
                android:centerX="0.2"
                android:centerY="0.15"
                android:startColor="#FF2B1677"
                android:centerColor="#FF170D49"
                android:endColor="#FF0B1A4A" />
        </shape>
    </item>
    <item>
        <bitmap android:gravity="center" android:src="@drawable/juzzio_launch_logo" />
    </item>
</layer-list>
